# Mobile public configuration belongs in mobile/.env (see mobile/.env.example).

# Backend-only secret. Never expose this as an EXPO_PUBLIC_ variable.
GEMINI_API_KEY=
PORT=8080

# Public Firebase project ID. Firebase Admin uses Application Default Credentials.
GOOGLE_CLOUD_PROJECT=

# Shared per-user quota across both AI endpoints.
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_GLOBAL_REQUESTS_PER_MINUTE=60
AI_GLOBAL_REQUESTS_PER_DAY=1000
# App Check Firebase application IDs (not package names), comma separated.
FIREBASE_APP_CHECK_APP_IDS=
