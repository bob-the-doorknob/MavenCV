# Mobile-safe public configuration. These values are bundled into the app.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Backend-only secret. Never expose this as an EXPO_PUBLIC_ variable.
GEMINI_API_KEY=
PORT=8080

# Public Firebase project ID. Firebase Admin uses Application Default Credentials.
GOOGLE_CLOUD_PROJECT=

# Shared per-user quota across both AI endpoints.
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
