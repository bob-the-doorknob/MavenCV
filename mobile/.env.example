# Backend base URL. Required unless EXPO_PUBLIC_USE_MOCK_API is 'true'.
EXPO_PUBLIC_API_BASE_URL=

# Set to 'true' to use local mock roadmap/CV-bullet generation instead of the
# real backend (fixed delays, no network, no auth needed).
EXPO_PUBLIC_USE_MOCK_API=false
EXPO_PUBLIC_FIREBASE_API_KEY=
# Public SDK keys only. Never put RevenueCat secret keys in this file.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# With mock mode on, force generateRoadmap/generateCvBullet to throw a given
# ApiError kind, to exercise error states: 'rate_limited' | 'server' | 'network'.
EXPO_PUBLIC_MOCK_FAIL=

# Public, published HTTPS pages. Production builds require all three.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Native Firebase configuration paths (use EAS file variables for builds).
# Download client config files from the SAME Firebase project as backend Auth.
GOOGLE_SERVICES_PLIST=
GOOGLE_SERVICES_JSON=
# Development builds only. Register the generated device debug token privately
# in Firebase App Check. Never commit or put debug tokens in EXPO_PUBLIC_*.
EXPO_PUBLIC_APP_CHECK_DEBUG=false
