{
  "expo": {
    "name": "Maven",
    "slug": "maven",
    "icon": "./assets/maven-mark.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "owner": "xphalo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maven.app"
    },
    "android": {
      "allowBackup": false,
      "package": "com.maven.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/maven-mark.png",
        "backgroundColor": "#FDF8E9"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "0bce248e-277a-4699-ab5d-02c393fe165d"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/maven-mark.png",
          "imageWidth": 220,
          "backgroundColor": "#FDF8E9",
          "dark": { "backgroundColor": "#FDF8E9" },
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
