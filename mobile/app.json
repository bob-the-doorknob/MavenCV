{
  "expo": {
    "name": "Maven",
    "slug": "maven",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "owner": "xphalo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maven.app"
    },
    "android": {
      "allowBackup": false,
      "package": "com.maven.app",
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "0bce248e-277a-4699-ab5d-02c393fe165d"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EE",
          "dark": { "backgroundColor": "#111214" },
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
