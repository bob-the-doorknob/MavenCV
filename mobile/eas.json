{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "demo": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_USE_MOCK_API": "false",
        "EXPO_PUBLIC_APP_CHECK_DEBUG": "true"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_USE_MOCK_API": "false" }
    }
  },
  "submit": {
    "production": {}
  }
}
